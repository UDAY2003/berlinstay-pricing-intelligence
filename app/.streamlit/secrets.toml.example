# Copy to app/.streamlit/secrets.toml (git-ignored) for local use, or paste into Streamlit Community Cloud > Settings > Secrets.
# Leave LLM_PROVIDER out (or "none") to run the "Ask the data" tab in demo mode without any key.
LLM_PROVIDER = "anthropic"          # anthropic | openai (any OpenAI-compatible endpoint) | none
LLM_API_KEY  = "paste-your-key-here"
LLM_MODEL    = "your-model-id"            # required when a provider is set
# LLM_BASE_URL = ""                 # optional endpoint override
# LLM_MAX_QUESTIONS_PER_SESSION = 15
